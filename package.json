{
  "name": "gap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gap \u2014 competitive platform for real-world running.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --no-audit --no-fund && npm --prefix client run build"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.1",
    "ws": "^8.18.0"
  }
}
