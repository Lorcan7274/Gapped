# Port. Railway injects PORT; we fall back to 3000 locally.
PORT=3000
HOST=0.0.0.0

# SQLite file path. Required-by-convention: always read from the environment.
# On Railway, point this at a mounted volume, e.g. /data/gap.db
DATABASE_PATH=./data/gap.db

# Controls log level and format. Anything but "production" logs at debug,
# and also echoes phone verification codes in the request-code response so
# sign-in works without an SMS provider (see AUTH_CODE_ECHO below).
NODE_ENV=development

# How long a texted sign-in code stays valid, in seconds.
AUTH_CODE_TTL_SECONDS=300

# Return the verification code in the request-code response. Defaults to on
# outside production. Forcing it on in production keeps a demo deploy usable
# without an SMS provider — but then anyone can sign in as any number.
# AUTH_CODE_ECHO=1

# textbee (textbee.dev) texts the verification codes through an Android phone
# paired with the account. Get the key at https://app.textbee.dev/dashboard.
# Leave unset to only log codes (with the echo above covering development).
# TEXTBEE_API_KEY=
# Optional: which paired phone sends. Defaults to the account's default device.
# TEXTBEE_DEVICE_ID=

# How far away a player can be and still show up on the radar (metres).
DISCOVERY_RADIUS_M=5000
# How far apart two ratings can be and still match (ELO points).
DISCOVERY_RATING_SPREAD=250
