# Port. Railway injects PORT; we fall back to 3000 locally.
PORT=3000
HOST=0.0.0.0

# SQLite file path. Required-by-convention: always read from the environment.
# On Railway, point this at a mounted volume, e.g. /data/gap.db
DATABASE_PATH=./data/gap.db

# When not "production", the SMS verification code is returned in the API
# response instead of being sent, so you can log in without an SMS provider.
NODE_ENV=development

# How far away a player can be and still show up on the radar (metres).
DISCOVERY_RADIUS_M=5000
# How far apart two ratings can be and still match (ELO points).
DISCOVERY_RATING_SPREAD=250

# Rate limits. The registration ceiling is generous on purpose: a room of
# people signing up at a demo shares one wifi address.
REGISTER_LIMIT=30
REGISTER_WINDOW_MINUTES=10
LOGIN_LIMIT=10
LOGIN_WINDOW_MINUTES=5
# Turn limiting off entirely (test runs only)
# RATE_LIMIT_DISABLED=1
